{
  "name": "kongono/app",
  "description": "The official Kongono Framework v1 application skeleton — zero-legacy PHP 8.5+ with zero Symfony dependency, built-in Dev Studio, OpenAPI 3.1, MCP, FrankenPHP worker, and Oshie/Chie/Hantei AI companions.",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "kongono",
    "php",
    "php85",
    "skeleton",
    "starter",
    "framework",
    "ai",
    "mcp",
    "frankenphp"
  ],
  "homepage": "https://github.com/anthonyiovanna/kongono-app",
  "authors": [
    {
      "name": "Anthony Iovanna",
      "email": "anthonyiovanna@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/anthonyiovanna/kongono/issues",
    "source": "https://github.com/anthonyiovanna/kongono-app",
    "docs": "https://github.com/anthonyiovanna/kongono/tree/main/docs"
  },
  "require": {
    "php": ">=8.5.0",
    "kongono/framework": "^1.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php -r \"if (!file_exists('.env') && file_exists('.env.example')) { copy('.env.example', '.env'); }\"",
      "@php -r \"require 'vendor/autoload.php'; $env = file_get_contents('.env'); if (is_string($env) && preg_match('/^APP_KEY=\\s*$/m', $env)) { $key = Kongono\\Security\\Encryptor::generateKey(); file_put_contents('.env', preg_replace('/^APP_KEY=\\s*$/m', 'APP_KEY=' . $key, $env, 1)); echo 'Generated 256-bit APP_KEY in .env' . PHP_EOL; }\""
    ],
    "dev": "@php vendor/bin/kongo serve --port=8000",
    "doctor": "@php vendor/bin/kongo doctor",
    "optimize": "@php vendor/bin/kongo optimize",
    "test": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit.xml.dist --fail-on-deprecation --fail-on-warning --fail-on-notice",
    "analyse": "@php -d memory_limit=512M vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "cs": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
    "cs:fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "quality": [
      "@cs",
      "@analyse",
      "@test"
    ]
  }
}
